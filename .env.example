# Адрес шлюза Kong (репозиторий gateway). Все запросы идут через него.
VITE_API_BASE_URL=http://localhost:8000

# Необязательный альтернативный источник растровых XYZ-тайлов и его атрибуция.
# Если одна из переменных пуста, используются тайлы OpenStreetMap.
# VITE_MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© Например
